# Local development: copy to ".env". In production these come from Google Secret Manager / Cloud Run (never commit real values).

NODE_ENV=development
PORT=8080

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET. Full database access. Server only. Never put this in sjks-frontend or sjks-admin.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay API keys: Dashboard -> Settings -> API Keys (use the rzp_test_ pair while testing). The key id is public, the secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay: Dashboard -> Settings -> Webhooks (URL: https://api.<domain>/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# Browser origins allowed to call the API, comma separated (website on :3000, admin panel on :5174 while developing)
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# true when running behind Cloud Run / a load balancer (so rate limits see the visitor's address)
TRUST_PROXY=false

# E-mail (the organisation's own SMTP account: Gmail app password, Zoho, cPanel mail ...). Needed for receipts, documents, broadcasts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
